[Unit]
Description=Create 1Password groups with the image's pinned GIDs
Documentation=man:sysusers.d(5)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target systemd-update-done.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=systemd-sysusers onepassword.conf

[Install]
WantedBy=sysinit.target
